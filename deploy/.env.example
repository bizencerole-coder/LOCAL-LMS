# Copy to deploy/.env and edit. Never commit deploy/.env.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use only letters, digits, '-' and '_' (they are embedded in URLs and the Nginx config).

# --- Database -----------------------------------------------------------------
POSTGRES_DB=campus_lms
POSTGRES_USER=campus_lms
POSTGRES_PASSWORD=replace-with-a-generated-secret

# --- Media --------------------------------------------------------------------
# Host directory holding the MP4 library (for OMV, the shared folder's absolute path,
# e.g. /srv/dev-disk-by-uuid-XXXX/campus-lms/videos). Mounted read-only into the containers.
VIDEO_ROOT=/srv/campus-lms/videos

# Shared by the API (signs playback URLs) and Nginx (verifies them). At least 32 characters.
MEDIA_SIGNING_SECRET=replace-with-a-generated-secret-of-at-least-32-chars

# Absolute base for playback URLs, e.g. http://lms.campus.lan or http://192.168.10.10.
# Recommended for any LAN deployment. Leave empty to use whatever address each tablet
# typed as the server (requests without a usable Host header are then rejected).
MEDIA_BASE_URL=

# How long a signed playback URL stays valid (seconds). When one expires mid-lesson the
# app requests a new one and continues from the same position.
PLAYBACK_URL_TTL_SECONDS=7200

# --- Sessions and progress ----------------------------------------------------
# Student sign-in lifetime (seconds). 28800 = 8 hours (one school day).
SESSION_TTL_SECONDS=28800
# A lesson counts as complete once the playback position reaches this fraction of its
# duration (seeking there counts; completion is permanent). 0 = only when the video
# plays to the end.
COMPLETION_THRESHOLD=0.9

# --- Capacity (defaults suit one host with 2 API workers) --------------------
# Database connections per API worker and how many requests a worker admits at once
# (default: pool size + overflow). Extra requests wait up to DB_ADMISSION_WAIT_SECONDS,
# then get 503 service_busy. PostgreSQL's max_connections (100) must cover
# WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) plus a few for admin tools.
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=20
#DB_POOL_TIMEOUT_SECONDS=5
#DB_ADMISSION_LIMIT=30
#DB_ADMISSION_WAIT_SECONDS=10

# --- Web server ---------------------------------------------------------------
# Address/port Nginx listens on. Use the server's LAN IP to avoid exposing other interfaces.
LMS_HTTP_BIND=0.0.0.0
LMS_HTTP_PORT=80

# --- API ----------------------------------------------------------------------
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
ENABLE_API_DOCS=true
WEB_CONCURRENCY=2
MIGRATE_ON_START=true
